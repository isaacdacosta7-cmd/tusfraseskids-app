{
  "$schema":"https://openapi.vercel.sh/vercel.json",
  "framework":null,
  "buildCommand":"",
  "installCommand":"npm ci",
  "outputDirectory":"public",
  "functions":{"api/portal.js":{"includeFiles":"private/**","maxDuration":30}},
  "redirects":[{"source":"/","destination":"/juegos","permanent":false}],
  "rewrites":[
    {"source":"/juegos","destination":"/api/portal"},
    {"source":"/juegos/","destination":"/api/portal"},
    {"source":"/juegos/enter","destination":"/api/portal?action=enter"},
    {"source":"/juegos/leave","destination":"/api/portal?action=leave"},
    {"source":"/juegos/:asset*","destination":"/api/portal?asset=:asset*"}
  ],
  "headers":[{"source":"/(.*)","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"same-origin"}]}]
}
